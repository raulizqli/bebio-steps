{
  "expo": {
    "name": "BebIO Steps",
    "slug": "bebio-steps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#6C63FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bebio.steps",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock BebIO Steps"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6C63FF"
      },
      "package": "com.bebio.steps"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
